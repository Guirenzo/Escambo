# Ambiente
NODE_ENV=development
PORT=3333
LOG_LEVEL=info

# Banco (bate com infra/docker-compose.yml)
DB_HOST=localhost
DB_PORT=3306
DB_USER=escambo
DB_PASSWORD=escambo
DB_NAME=escambo
DB_CONNECTION_LIMIT=10

# Auth
JWT_SECRET=troque-isto-em-producao-use-no-minimo-32-caracteres
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12
REFRESH_TOKEN_EXPIRES_DAYS=7

# Hardening HTTP / operacional
# CORS: '*' reflete a origem; em produção use a lista fixa, ex.: https://app.escambo.com,https://admin.escambo.com
CORS_ORIGINS=*
# Limite do corpo das requisições JSON
BODY_LIMIT=1mb
# Confiança em proxy reverso (X-Forwarded-For): false | true | loopback | nº de hops
TRUST_PROXY=loopback
# Rate limiting por IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_WINDOW_MS=300000
LOGIN_RATE_LIMIT_MAX=10
# Encerramento gracioso (drenagem de conexões)
SHUTDOWN_TIMEOUT_MS=10000

# Jobs em background (aprovação tácita de entregas sem resposta do cliente, etc.)
# Em cluster, mantenha ligado em UMA instância só.
JOBS_ENABLED=true
JOBS_INTERVAL_MS=300000

# Pagamentos (depósitos na carteira via PIX). Só existe o gateway SIMULADO neste estágio.
# PAYMENTS_SIMULATE libera o endpoint que confirma a cobrança sem banco — DESLIGUE em produção.
PAYMENTS_SIMULATE=true
# Segredo do webhook do gateway (header x-webhook-secret). Vazio = webhook desligado.
PAYMENT_WEBHOOK_SECRET=
# Validade da cobrança PIX de depósito (minutos)
DEPOSIT_EXPIRES_MINUTES=30

# Admins da plataforma: e-mails separados por vírgula ("@dominio.com" libera o domínio inteiro).
# Quem se cadastra ou entra com um e-mail da lista vira admin (painel /admin, mediação de disputas).
ADMIN_EMAILS=
