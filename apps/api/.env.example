# Ambiente
NODE_ENV=development
PORT=3333
LOG_LEVEL=info

# Banco (bate com infra/docker-compose.yml)
DB_HOST=localhost
DB_PORT=3306
DB_USER=escambo
DB_PASSWORD=escambo
DB_NAME=escambo
DB_CONNECTION_LIMIT=10

# Auth
JWT_SECRET=troque-isto-em-producao-use-no-minimo-32-caracteres
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12
REFRESH_TOKEN_EXPIRES_DAYS=7

# Hardening HTTP / operacional
# CORS: '*' reflete a origem; em produção use a lista fixa, ex.: https://app.escambo.com,https://admin.escambo.com
CORS_ORIGINS=*
# Limite do corpo das requisições JSON
BODY_LIMIT=1mb
# Confiança em proxy reverso (X-Forwarded-For): false | true | loopback | nº de hops
TRUST_PROXY=loopback
# Rate limiting por IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_WINDOW_MS=300000
LOGIN_RATE_LIMIT_MAX=10
# Encerramento gracioso (drenagem de conexões)
SHUTDOWN_TIMEOUT_MS=10000

# Jobs em background (aprovação tácita de entregas sem resposta do cliente, etc.)
# Em cluster, mantenha ligado em UMA instância só.
JOBS_ENABLED=true
JOBS_INTERVAL_MS=300000

# Pagamentos (depósitos na carteira via PIX). Só existe o gateway SIMULADO neste estágio.
# PAYMENTS_SIMULATE libera o endpoint que confirma a cobrança sem banco — DESLIGUE em produção.
PAYMENTS_SIMULATE=true
# Segredo do webhook do gateway (header x-webhook-secret). Vazio = webhook desligado.
PAYMENT_WEBHOOK_SECRET=
# Validade da cobrança PIX de depósito (minutos)
DEPOSIT_EXPIRES_MINUTES=30

# Cópias de dados (LGPD): pasta dos arquivos gerados e validade do download (dias)
DATA_DIR=data
EXPORT_TTL_DAYS=7
# Anexos do chat (imagem, PDF, ZIP): ficam em DATA_DIR/uploads. Limite por arquivo (MB) e uploads por IP por hora
UPLOAD_MAX_MB=10
UPLOAD_RATE_LIMIT_MAX=60

# E-mail transacional (confirmação de e-mail, redefinição de senha, avisos de contratação/pagamento).
# APP_URL entra nos links dos e-mails. MAIL_PROVIDER: simulated (caixa de saída no banco, lida no
# painel admin — demo/dev) | smtp (envia de verdade via SMTP_*) | off.
APP_URL=http://localhost:5173
MAIL_PROVIDER=simulated
MAIL_FROM=Escambo <nao-responda@escambo.demo>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_VERIFY_TTL_HOURS=24
# Avisos push no navegador (ADR 52): simulated (padrão), webpush ou off. Sem chaves, um par VAPID
# é gerado a cada subida — vale só para demo e desenvolvimento, porque webpush exige as duas
# chaves fixas ("npx web-push generate-vapid-keys") e recusa subir sem elas.
PUSH_PROVIDER=simulated
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=mailto:nao-responda@escambo.demo
PASSWORD_RESET_TTL_MINUTES=60
# Hora padrão do resumo diário de notificações e do alerta diário das buscas salvas, para quem não escolheu a própria no perfil; vale no fuso de cada pessoa, Brasília se não escolheu (ADR 42 e 46). Também a hora (Brasília) do relatório diário da meta da moderação aos admins (ADR 55)
DIGEST_HOUR=8
# Hora (Brasília) do expurgo diário de anexos do chat (retenção em platform_settings.attachment_retention_days)
ATTACHMENT_PURGE_HOUR=4

# Admins da plataforma: e-mails separados por vírgula ("@dominio.com" libera o domínio inteiro).
# Quem se cadastra ou entra com um e-mail da lista vira admin (painel /admin, mediação de disputas).
ADMIN_EMAILS=
