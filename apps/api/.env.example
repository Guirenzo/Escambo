# Ambiente
NODE_ENV=development
PORT=3333
LOG_LEVEL=info

# Banco (bate com infra/docker-compose.yml)
DB_HOST=localhost
DB_PORT=3306
DB_USER=escambo
DB_PASSWORD=escambo
DB_NAME=escambo
DB_CONNECTION_LIMIT=10

# Auth
JWT_SECRET=troque-isto-em-producao-use-no-minimo-32-caracteres
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12
REFRESH_TOKEN_EXPIRES_DAYS=7

# Hardening HTTP / operacional
# CORS: '*' reflete a origem; em produção use a lista fixa, ex.: https://app.escambo.com,https://admin.escambo.com
CORS_ORIGINS=*
# Limite do corpo das requisições JSON
BODY_LIMIT=1mb
# Confiança em proxy reverso (X-Forwarded-For): false | true | loopback | nº de hops
TRUST_PROXY=loopback
# Rate limiting por IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_WINDOW_MS=300000
LOGIN_RATE_LIMIT_MAX=10
# Encerramento gracioso (drenagem de conexões)
SHUTDOWN_TIMEOUT_MS=10000
