# Variáveis do docker-compose (copie para .env na raiz; tudo tem padrão, então é opcional).
# Portas publicadas no host
WEB_PORT=8090
API_PORT=3333
DB_PORT=3306
# Banco (o container do MySQL é criado com estes valores)
DB_NAME=escambo
DB_USER=escambo
DB_PASSWORD=escambo
DB_ROOT_PASSWORD=escambo_root
# API
JWT_SECRET=troque-isto-em-producao-com-no-minimo-32-caracteres
CORS_ORIGINS=*
LOG_LEVEL=info
# Rate limit por IP (padrões de produção; para rodar os e2e contra a stack, suba LOGIN_RATE_LIMIT_MAX)
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10
# Admins da plataforma (e-mails separados por vírgula). Troque em produção.
ADMIN_EMAILS=admin@escambo.demo
# Pagamentos: gateway simulado. PAYMENTS_SIMULATE=false em produção; segredo do webhook do gateway.
PAYMENTS_SIMULATE=true
PAYMENT_WEBHOOK_SECRET=
# Cópias de dados (LGPD): validade do download em dias (arquivos no volume api_data)
EXPORT_TTL_DAYS=7
# E-mails: endereço público do app nos links; provedor simulado (caixa de saída no admin) ou smtp
APP_URL=http://localhost:8090
MAIL_PROVIDER=simulated
MAIL_FROM=Escambo <nao-responda@escambo.demo>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
