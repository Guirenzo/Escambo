# Escambo em PRODUÇÃO (docker-compose.prod.yml). Copie para `.env` na mesma pasta e preencha.
# Tudo marcado como OBRIGATÓRIO faz o compose se recusar a subir se estiver vazio.
# Gere segredos com:  openssl rand -base64 48

# Domínio público (DNS A/AAAA apontando para a VPS) e e-mail para avisos do Let's Encrypt — OBRIGATÓRIOS
DOMAIN=app.seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br

# Imagens publicadas pelo CI no GHCR. IMAGE_TAG: `latest`, um sha curto (ex.: a1b2c3d) ou uma versão (ex.: 1.2.0).
# O workflow Deploy reescreve esta linha a cada deploy (sha curto do commit no ar).
# Rollback: Actions → Deploy → Run workflow, com a tag anterior (DEPLOY.md, seção 3).
IMAGE_TAG=latest
# API_IMAGE=ghcr.io/guirenzo/escambo-api
# WEB_IMAGE=ghcr.io/guirenzo/escambo-web

# Banco — senhas OBRIGATÓRIAS
DB_NAME=escambo
DB_USER=escambo
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Sessões (JWT + refresh rotativo) — OBRIGATÓRIO, 32+ caracteres aleatórios
JWT_SECRET=

# Cifragem da chave PIX e dos dados bancários dos saques no banco (RNF-017, AES-256-GCM) — RECOMENDADO.
# 32 bytes em base64, gerados com:  openssl rand -base64 32
# Vazia, a API sobe e grava em texto puro, avisando no log. Guarde a chave fora da VPS também: sem ela,
# o que foi cifrado não volta. Depois de configurar (e a cada troca de chave), cifre as linhas antigas uma vez:
#   docker compose -f docker-compose.prod.yml run --rm --no-deps api node dist/scripts/encrypt-withdrawal-fields.js
# Para trocar a chave: a antiga vai para FIELD_ENCRYPTION_OLD_KEYS (só leitura, separadas por vírgula),
# a nova para FIELD_ENCRYPTION_KEY, sobe a API e roda o comando acima; depois a antiga pode sair.
FIELD_ENCRYPTION_KEY=
# FIELD_ENCRYPTION_OLD_KEYS=

# Admins da plataforma: e-mails separados por vírgula ("@dominio.com" libera o domínio inteiro) — OBRIGATÓRIO
ADMIN_EMAILS=

# Pagamentos: ainda não há gateway real (ADR 15). Simulador DESLIGADO em produção; ligue só num piloto
# sem dinheiro de verdade. PAYMENT_WEBHOOK_SECRET protege o webhook quando um gateway for plugado.
PAYMENTS_SIMULATE=false
PAYMENT_WEBHOOK_SECRET=

# E-mail transacional via SMTP (confirmação de e-mail, redefinição de senha, avisos) — MAIL_FROM OBRIGATÓRIO
MAIL_PROVIDER=smtp
MAIL_FROM=Escambo <nao-responda@seudominio.com.br>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
DIGEST_HOUR=8

# Backup diário (RNF-009): o serviço `backup` do compose faz sozinho, sem cron. Banco (mysqldump com os
# triggers) e arquivos da API (anexos, fotos, quarentena), com .sha256 ao lado, em BACKUP_PATH; o
# resultado fica em BACKUP_PATH/last-backup.json e no log (docker compose -f docker-compose.prod.yml logs backup).
# Crie a pasta antes de subir (mkdir backups): os arquivos ficam com o dono dela, com permissão 600.
# Horário de Brasília (HH:MM). Retenção: as BACKUP_KEEP cópias mais recentes e tudo com menos de BACKUP_KEEP dias.
BACKUP_HOUR=03:00
BACKUP_KEEP=7
# BACKUP_PATH=./backups

# Cópia dos backups para fora da VPS, num S3 compatível (DigitalOcean Spaces, AWS S3, B2…) — RECOMENDADO.
# Liga com `offsite` em COMPOSE_PROFILES (ex.: COMPOSE_PROFILES=offsite ou monitoring,offsite) e estas
# variáveis. Use uma chave só deste bucket, de preferência sem permissão de apagar, e uma regra de ciclo
# de vida no bucket para a retenção; OFFSITE_KEEP_DAYS (vazio = não apaga nada) faz a limpeza por aqui.
# Endpoint do Spaces: <região>.digitaloceanspaces.com (ex.: nyc3.digitaloceanspaces.com).
# OFFSITE_S3_ENDPOINT=
# OFFSITE_S3_BUCKET=
# OFFSITE_S3_PREFIX=escambo
# OFFSITE_S3_ACCESS_KEY=
# OFFSITE_S3_SECRET_KEY=
# OFFSITE_S3_PROVIDER=DigitalOcean
# OFFSITE_S3_REGION=
# OFFSITE_KEEP_DAYS=

# Opcionais
LOG_LEVEL=info
EXPORT_TTL_DAYS=7
# Expurgo do audit_logs com mais de N dias (RNF-037). Vazio = desligado. Mínimo 90 (a API não sobe com
# menos); login com IP é registro de acesso, que o Marco Civil (art. 15) pede por 6 meses: prefira 180+.
# AUDIT_LOG_PURGE_DAYS=
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10
# Portas do Caddy no host (mude só para testar a stack de produção numa máquina que já usa 80/443)
# HTTP_PORT=80
# HTTPS_PORT=443

# Observabilidade (ADR 59; ver docs/wiki/Observabilidade.md)
# Falhas do servidor (erros 5xx, falhas de job, quedas do processo) no Sentry, sem dados pessoais. Vazio = desligado.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# Prometheus + Grafana + sonda de uptime: descomente as duas linhas DEPOIS do primeiro deploy pelo workflow
# Deploy (é ele que copia deploy/monitoring/ para a VPS; sem a pasta, o compose recusa a subida).
# O Grafana só escuta no 127.0.0.1 da VPS (ssh -L 3000:127.0.0.1:3000 usuario@vps) e não sobe sem senha.
# O perfil traz também o node-exporter, que expõe a idade do último backup (alerta BackupAtrasado).
# Com a cópia fora da VPS: COMPOSE_PROFILES=monitoring,offsite
# COMPOSE_PROFILES=monitoring
# GRAFANA_ADMIN_PASSWORD=
# Os alertas saem por e-mail pelo SMTP acima, para este endereço (vazio = o ACME_EMAIL).
# ALERT_EMAIL_TO=
# PROMETHEUS_RETENTION=45d
